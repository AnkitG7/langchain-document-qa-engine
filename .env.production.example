# DocMind Production Environment Configuration Template
ENVIRONMENT=production

# Application & Workers
PORT=8000
HOST=0.0.0.0
WORKERS=4
LOG_LEVEL=info

# Persistent Vector Storage (PostgreSQL + PGVector)
PGVECTOR_URL=postgresql+psycopg://docmind_user:docmind_password@localhost:5432/docmind_db
PGVECTOR_COLLECTION=docmind_production_vectors

# Production Cache Subsystem (Redis)
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=600

# LLM & Embedding Providers
LLM_PROVIDER=ollama
OLLAMA_MODEL=gemma4:cloud
OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional Cloud API Fallbacks
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observability & Tracing (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=DocMind-Production
