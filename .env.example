# LLM Generation / Reasoning (Ollama Gemma)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_MODEL_NAME=gemma4:cloud
DEFAULT_TEMPERATURE=0.0

# Dedicated Embedding Model (Separate from Chat Model)
DEFAULT_EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ollama Local Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=gemma4:cloud

# Ingestion Defaults
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_SPLITTER_TYPE=recursive

# Optional Cloud API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=docmind-langchain-qa
